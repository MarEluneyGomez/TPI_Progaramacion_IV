# Copiar como .env y completar. El .env no se entrega.

# PostgreSQL (la base se crea sola si no existe)
DATABASE_URL=postgresql://postgres:<tu-contraseña>@localhost:5432/foodstore_db
# Alternativa para desarrollo sin PostgreSQL:
# DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar el JWT, de al menos 32 caracteres.
# Generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
